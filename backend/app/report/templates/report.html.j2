<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="generator" content="AI">
<title>求职准备度诊断报告 · {{ meta.display_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;800&family=Noto+Serif+SC:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0a1e50; --blue:#0052d9; --orange:#ff6b35; --text:#1a1a2e;
    --muted:#788296; --bg-soft:#f7f8fa; --line:#dfe5f2; --card:#e8eefb; --peach:#fff4ee;
  }
  *{box-sizing:border-box}
  body{margin:0;background:#fff;color:var(--text);
    font-family:"Noto Serif SC","Songti SC",serif;font-size:15px;line-height:1.85}
  h1,h2,h3,h4,.sans{font-family:"Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif}
  main{max-width:860px;margin:0 auto;padding:0 16px 64px}
  section{margin-top:44px}
  a{color:var(--blue)}

  /* 封面 */
  .cover{background:linear-gradient(135deg,#0a1e50,#0c2340 55%,#142b52);color:#fff;
    padding:56px 20px 44px;text-align:left}
  .cover .inner{max-width:860px;margin:0 auto}
  .eyebrow{color:var(--orange);font-size:11px;letter-spacing:.35em;font-weight:700;
    font-family:"Noto Sans SC",sans-serif;text-transform:uppercase}
  .cover h1{font-size:30px;margin:14px 0 6px;letter-spacing:.04em}
  .cover .sub{color:#b9c6e8;font-size:15px}
  .cover .bar{width:72px;height:4px;background:var(--orange);margin:18px 0}
  .cover .metas{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
  .cover .meta{border:1px solid rgba(255,255,255,.25);border-radius:999px;
    padding:3px 12px;font-size:12px;color:#e6ecf9;font-family:"Noto Sans SC",sans-serif}

  h2{font-family:"Noto Sans SC",sans-serif;font-size:21px;color:var(--navy);
    margin:8px 0 6px;padding-bottom:9px;border-bottom:2px solid var(--blue)}
  h3{font-family:"Noto Sans SC",sans-serif;font-size:15.5px;color:var(--blue);margin:26px 0 8px}
  .secno{color:var(--orange);font-size:10.5px;letter-spacing:.3em;font-weight:700;
    font-family:"Noto Sans SC",sans-serif}
  .muted{color:var(--muted);font-size:12.5px}
  .num{color:var(--orange);font-weight:800;font-family:"Noto Sans SC",sans-serif}

  table{border-collapse:collapse;width:100%;margin:14px 0;font-size:13.5px;
    font-family:"Noto Sans SC",sans-serif}
  th{background:var(--navy);color:#fff;text-align:left;padding:8px 12px;font-weight:600;font-size:12.5px}
  td{padding:8px 12px;border-bottom:1px solid var(--line);vertical-align:top}
  tr:nth-child(even) td{background:var(--bg-soft)}
  td.k{color:var(--blue);font-weight:600;white-space:nowrap}

  .callout{background:var(--bg-soft);border-left:4px solid var(--blue);border-radius:6px;
    padding:13px 16px;margin:14px 0}
  .callout.dark{background:var(--navy);border-left-color:var(--orange);color:#e6ecf9}
  .callout.dark .t,.callout.dark b{color:var(--orange)}
  .callout.peach{background:var(--peach);border-left-color:var(--orange)}
  .callout .t{font-weight:700;color:var(--blue);margin-bottom:5px;font-family:"Noto Sans SC",sans-serif}
  .callout.peach .t{color:var(--orange)}

  /* 优势分享卡 */
  .sharecard{background:linear-gradient(135deg,#0a1e50,#142b52);color:#fff;border-radius:16px;
    padding:26px 22px;margin:28px 0 8px;position:relative;overflow:hidden}
  .sharecard .brand{display:flex;justify-content:space-between;align-items:center;
    font-family:"Noto Sans SC",sans-serif;font-size:11px;letter-spacing:.2em;color:#b9c6e8}
  .sharecard .ai-badge{border:1px solid rgba(255,255,255,.35);border-radius:4px;
    padding:1px 7px;font-size:10px;letter-spacing:.1em}
  .sharecard h3{color:var(--orange);margin:14px 0 4px;font-size:14px;letter-spacing:.2em}
  .sharecard .strength{border-left:3px solid var(--orange);padding:4px 0 4px 12px;margin:12px 0}
  .sharecard .strength .st{font-weight:700;font-family:"Noto Sans SC",sans-serif;font-size:15px}
  .sharecard .strength .sd{color:#cfd9f2;font-size:13px;margin-top:2px}

  /* 维度卡 */
  .dimcard{border:1px solid var(--line);border-radius:10px;margin:18px 0;overflow:hidden}
  .dimhead{background:var(--card);border-left:4px solid var(--blue);padding:10px 14px;
    display:flex;justify-content:space-between;align-items:baseline;gap:8px}
  .dimhead .dn{font-weight:700;color:var(--navy);font-family:"Noto Sans SC",sans-serif}
  .dimhead .ds{color:var(--orange);font-weight:800;font-size:19px;font-family:"Noto Sans SC",sans-serif;white-space:nowrap}
  .dimhead .ds.pending{color:var(--muted);font-size:13px;font-weight:700}
  .dimbody{padding:6px 16px 14px}
  blockquote{margin:8px 0;padding:8px 14px;background:var(--bg-soft);border-left:3px solid var(--orange);
    border-radius:4px;font-size:13.5px;color:#3a4258}
  .evi-src{color:var(--muted);font-size:11.5px;font-family:"Noto Sans SC",sans-serif}

  /* 行动卡 */
  .actioncard{border:1px solid var(--line);border-top:3px solid var(--orange);border-radius:10px;
    padding:14px 16px;margin:12px 0}
  .actioncard .at{font-weight:700;color:var(--navy);font-family:"Noto Sans SC",sans-serif}
  .tpl{background:var(--bg-soft);border:1px dashed var(--line);border-radius:6px;padding:10px 12px;
    font-size:12.5px;white-space:pre-wrap;font-family:"Noto Sans SC",sans-serif;margin-top:8px}

  details{border:1px solid var(--line);border-radius:10px;margin:14px 0;padding:0 16px}
  details>summary{cursor:pointer;padding:12px 0;font-weight:700;color:var(--navy);
    font-family:"Noto Sans SC",sans-serif;list-style:none}
  details>summary::before{content:"▸ ";color:var(--orange)}
  details[open]>summary::before{content:"▾ "}
  details>.dcontent{padding-bottom:14px}

  nav.toc-nav{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--line);z-index:9;
    overflow-x:auto;white-space:nowrap;-webkit-overflow-scrolling:touch}
  nav.toc-nav .inner{max-width:860px;margin:0 auto;padding:9px 16px;display:flex;gap:16px}
  nav.toc-nav a{color:var(--muted);text-decoration:none;font-size:12.5px;font-family:"Noto Sans SC",sans-serif}

  ul{margin:8px 0;padding-left:22px}
  li{margin:5px 0}
  .scale{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin:16px 0 4px;
    font-family:"Noto Sans SC",sans-serif}
  .scell{border-radius:6px;padding:7px 5px;text-align:center;border:1px solid var(--line);background:var(--bg-soft)}
  .scell .sn{font-weight:800;font-size:15px;color:var(--navy)}
  .scell .sl{font-size:10.5px;color:var(--muted)}
  .scell.four{background:var(--navy);border-color:var(--navy)}
  .scell.four .sn,.scell.four .sl{color:#fff}
  .scell.four .sn::after{content:" ▲";color:var(--orange)}
  @media(min-width:640px){.scale{grid-template-columns:repeat(8,1fr)}}

  footer{border-top:1px solid var(--line);color:var(--muted);text-align:center;
    padding:26px 16px;font-size:12px;letter-spacing:.12em;font-family:"Noto Sans SC",sans-serif}

  /* 窄屏表格折叠成卡片 */
  @media(max-width:640px){
    table.fold thead{display:none}
    table.fold tr{display:block;border:1px solid var(--line);border-radius:8px;margin:10px 0;padding:6px 10px}
    table.fold td{display:block;border:none;padding:4px 0;background:none!important}
    table.fold td::before{content:attr(data-label);display:block;font-size:11px;color:var(--muted)}
  }

  @media print{
    nav.toc-nav{display:none}
    body{font-size:10.5pt}
    section{page-break-before:always;margin-top:0;padding-top:24px}
    section.no-break{page-break-before:avoid}
    .cover{min-height:85vh}
    details{border:none;padding:0}
    details>summary{display:none}
    details:not([open])>.dcontent{display:block}
    @page{
      margin:18mm 14mm;
      @top-left{content:"{{ meta.brand_name }}"}
      @bottom-center{content:"求职准备度诊断报告 · {{ meta.display_name }}  —  第 " counter(page) " 页"}
    }
  }
</style>
</head>
<body>

<!-- ████ 封面 -->
<header class="cover">
  <div class="inner">
    <div class="eyebrow">{{ meta.brand_tagline_en }}</div>
    <h1>求职准备度诊断报告</h1>
    <div class="sub">{{ meta.display_name }} · 首次诊断访谈评估</div>
    <div class="bar"></div>
    <div class="metas">
      <span class="meta">{{ meta.date }}</span>
      <span class="meta">{{ '快速诊断' if meta.mode == 'quick' else '完整诊断' }}</span>
      <span class="meta">诊断完成度 {{ meta.completion }} 维度</span>
      {% if meta.goal_clear and meta.target_role %}<span class="meta">目标岗位：{{ meta.target_role }}</span>
      {% else %}<span class="meta">探索路径（方向打样中）</span>{% endif %}
      <span class="meta">AI 生成</span>
    </div>
  </div>
</header>

<nav class="toc-nav"><div class="inner">
  <a href="#summary">速读版</a><a href="#c1">快照</a><a href="#c2">评分方法</a><a href="#c3">评分总览</a>
  <a href="#c4">逐维详解</a><a href="#c5">亮点</a><a href="#c6">结构结论</a><a href="#c7">行动计划</a>
  <a href="#c8">执行机制</a><a href="#c9">结语</a>
</div></nav>

<main>

<!-- ████ 优势分享卡（独立首屏区块：只含优势牌＋品牌角标） -->
{% if narrative1.strengths %}
<section class="no-break" id="sharecard" style="margin-top:28px">
  <div class="sharecard">
    <div class="brand"><span>{{ meta.brand_name }} · {{ meta.brand_tagline_en }}</span><span class="ai-badge">AI 生成</span></div>
    <h3>我的优势牌</h3>
    {% for s in narrative1.strengths %}
    <div class="strength"><div class="st">{{ s.title }}</div><div class="sd">{{ s.detail }}</div></div>
    {% endfor %}
  </div>
  <p class="muted" style="text-align:center">↑ 这张优势卡可以单独分享（不含分数与个人信息）；完整报告仅你本人可见</p>
</section>
{% endif %}

<!-- ████ 执行摘要（速读版） -->
<section class="no-break" id="summary">
  <div class="secno">EXECUTIVE SUMMARY</div>
  <h2>速读版 · 五分钟看完关键结论</h2>
  {% if structure.one_liner %}
  <div class="callout dark"><div class="t">一句话结论</div>{{ structure.one_liner }}
    {% if structure.keywords %}<div style="margin-top:8px">{% for kw in structure.keywords %}<b>#{{ kw }}</b>&nbsp;&nbsp;{% endfor %}</div>{% endif %}
  </div>
  {% endif %}
  <p>{{ narrative1.exec_summary }}</p>

  {% if structure.first_priority_action and structure.first_priority_action.action %}
  <div class="callout peach">
    <div class="t">第一优先动作（本周就做这一件）</div>
    <b>{{ structure.first_priority_action.action }}</b><br>
    <span class="muted">最关键缺口：{{ structure.first_priority_action.gap }} ·
    为什么是它：{{ structure.first_priority_action.reason }} ·
    预计耗时：{{ structure.first_priority_action.time_cost }}</span>
    {% if structure.first_priority_action.sample %}<br><span class="muted">完成后的样子：{{ structure.first_priority_action.sample }}</span>{% endif %}
  </div>
  {% endif %}

  {% if narrative1.to_fill %}
  <h3>待补齐（都是「还没做」，不是「做不了」）</h3>
  <ul>{% for t in narrative1.to_fill %}<li>{{ t }}</li>{% endfor %}</ul>
  {% endif %}
  {% if narrative1.potential_direction %}<h3>潜力方向</h3><p>{{ narrative1.potential_direction }}</p>{% endif %}
  {% if narrative1.one_sentence_for_you %}
  <div class="callout"><div class="t">给你的一句话</div>{{ narrative1.one_sentence_for_you }}</div>
  {% endif %}
</section>

<!-- ████ 报告说明（固定） -->
<section class="no-break">
  <div class="secno">ABOUT THIS REPORT</div>
  <h2>报告说明</h2>
  <ul>
    <li>本报告基于你与 AI 诊断师的 <b class="num">{{ meta.turn_count }}</b> 轮结构化对话自动生成（你的发言 {{ meta.user_message_count }} 条），由 AI 生成，运营团队提供人工纠错通道。</li>
    <li><b>评分口径三条：</b>① 只对已发生、可核对的证据计分，潜力、意愿、性格不计分；② 每维 0–7 整数分；③ 没问到、答不清的维度记「待核实」，不计入总分——「没做过」是有效信息，如实计 0–1 分。</li>
    <li><b>坦诚声明：</b>这是一次 AI 对话观察形成的参考意见，存在单次观察的波动；它不代表你的潜力，更不构成录用预测或职业资格判断。分数低是进度低，不是能力低。</li>
    <li>报告中的每句引用都经过程序与原始对话逐字核验（本次引用命中率要求 100%，未通过核验的内容已被剔除或标注待确认）。发现与事实不符之处，请使用报告页的「内容与事实不符？告诉我们」入口。</li>
  </ul>
</section>

<!-- ████ 第一章 概览与快照 -->
<section id="c1">
  <div class="secno">CHAPTER 01</div>
  <h2>第一章 · 概览与{{ '学员快照' if meta.identity == 'student' else '职业履历卡' }}</h2>
  <p>{{ facts.profile_summary }}</p>
  {% if narrative1.snapshot.rows %}
  <table class="fold">
    <thead><tr><th style="width:30%">项目</th><th>内容</th></tr></thead>
    {% for row in narrative1.snapshot.rows %}
    <tr><td class="k" data-label="项目">{{ row.label }}</td><td data-label="内容">{{ row.value }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}
  {% if facts.key_facts %}
  <h3>关键事实清单</h3>
  <ul>{% for f in facts.key_facts %}<li>{{ f }}</li>{% endfor %}</ul>
  {% endif %}
  {% if narrative1.environment_observation %}
  <h3>环境观察</h3><p>{{ narrative1.environment_observation }}</p>
  {% endif %}
  {% if memorable_quotes %}
  <h3>最值得记住的{{ memorable_quotes | length }}句话</h3>
  {% for q in memorable_quotes %}
  <blockquote>「{{ q.quote }}」<div class="evi-src">—— 你在访谈中的原话 · {{ q.point }}</div></blockquote>
  {% endfor %}
  {% endif %}
</section>

<!-- ████ 第二章 评分方法（整章固定，杜绝口径漂移） -->
<section id="c2">
  <div class="secno">CHAPTER 02 · FIXED</div>
  <h2>第二章 · 评分方法：七个包子的账本</h2>
  <p>求职不是一件事，而是<b>七件可评分的任务</b>。我们把每个维度的就绪度想象成「吃饱要吃七个包子」：你现在吃到第几个，就是几分。<b>分数不是天花板，只是进度条；不是判决书，而是一本「包子账本」。</b></p>
  <div class="scale">
    {% for label in scale_labels %}
    <div class="scell{{ ' four' if loop.index0 == 4 else '' }}"><div class="sn">{{ loop.index0 }}</div><div class="sl">{{ label }}</div></div>
    {% endfor %}
  </div>
  <p class="muted">▲ 4 分线 =「有完整岗位交付、可接受追问」——这是一条参考线：关键维度过 4 分后，通常值得开始投递、用市场反馈继续打磨（不构成结果承诺）。</p>
  <table class="fold">
    <thead><tr><th>分档</th><th>语义</th><th>对应的「包子」</th></tr></thead>
    {% for band, meaning, baozi in band_table %}
    <tr><td class="k" data-label="分档">{{ band }}</td><td data-label="语义">{{ meaning }}</td><td data-label="包子">{{ baozi }}</td></tr>
    {% endfor %}
  </table>
  <div class="callout">
    <div class="t">评分三原则</div>
    ① 只对已发生、可核对的证据计分——潜力、意愿、性格不计分；② 每维整数分；③「没做过」≠「不知道」：明确确认没做过的，如实计 0–1 分；没聊到、说不清的，记「待核实」不计分、不猜测。
  </div>
</section>

<!-- ████ 第三章 评分总览 -->
<section id="c3">
  <div class="secno">CHAPTER 03</div>
  <h2>第三章 · 评分总览</h2>
  {% if totals.scored_count < 7 %}
  <div class="callout peach"><div class="t">部分报告说明</div>
  本次诊断覆盖了 {{ totals.scored_count }}/7 个维度，其余维度记「待核实」（雷达图中置灰）。总分只按已评维度小计呈现；待核实不代表低分，只是还没聊到。想补全？随时可以再做一次诊断。</div>
  {% endif %}

  <p style="text-align:center" class="sans">已评维度小计
    <span class="num" style="font-size:30px">{{ totals.total }}</span>
    <span class="muted">/ {{ totals.max }}（已评 {{ totals.scored_count }} 维）</span>
  </p>
  {{ radar_svg | safe }}
  <p class="muted" style="text-align:center">虚线七边形为 4 分参考线；灰色轴为待核实维度，不计入总分。</p>

  <table class="fold">
    <thead><tr><th>维度</th><th style="width:64px">得分</th><th>一句话结论</th></tr></thead>
    {% for d in dimensions %}
    <tr>
      <td class="k" data-label="维度">{{ loop.index }} · {{ d.short }}</td>
      <td data-label="得分">{% if d.pending %}<span class="muted">待核实</span>{% else %}<b class="num">{{ d.score }}</b> / 7{% endif %}</td>
      <td data-label="结论">{{ d.core_judgement or '本次未充分覆盖，暂不下结论' }}</td>
    </tr>
    {% endfor %}
  </table>

  {% if totals.overall_judgment_allowed %}
  <h3>输入端 / 输出端结构</h3>
  <p class="sans">输入端（维 1–4 · 原材料）：<b class="num">{{ totals.input_total }}</b><span class="muted"> / {{ totals.input_max }}</span>
  &nbsp;&nbsp;·&nbsp;&nbsp;输出端（维 5–7 · 成品）：<b class="num">{{ totals.output_total }}</b><span class="muted"> / {{ totals.output_max }}</span></p>
  <p>{{ structure.io_interpretation }}</p>
  {% if structure.conclusion_tags %}
  <p>{% for tag in structure.conclusion_tags %}<b class="num">#{{ tag }}</b>&nbsp;&nbsp;{% endfor %}</p>
  {% endif %}
  {% else %}
  <div class="callout"><div class="t">为什么本次不下整体判断</div>
  已评分的维度少于 4 个，不足以支撑对整体结构的判断。下方改为交付「已确认的发现＋待补信息清单」——这同样是有效的诊断成果。</div>
  {% endif %}
</section>

<!-- ████ 第四章 逐维详解 -->
<section id="c4">
  <div class="secno">CHAPTER 04</div>
  <h2>第四章 · 七维逐项详解</h2>
  {% for d in dimensions %}
  <div class="dimcard">
    <div class="dimhead">
      <span class="dn">{{ loop.index }} · {{ d.name }}</span>
      {% if d.pending %}<span class="ds pending">待核实</span>
      {% else %}<span class="ds">{{ d.score }}<span style="font-size:12px;color:var(--muted)"> /7</span></span>{% endif %}
    </div>
    <div class="dimbody">
      {% if d.pending %}
        <p class="muted">{% if d.evidence_state == 'not_applicable' %}该维度对你当前的场景不适用，不计入总分。{% else %}本次对话没有充分覆盖这个维度（或信息还不够下判断），为了不冤枉你，我们不打分、不猜测。下次诊断可以优先聊它。{% endif %}</p>
        {% if d.core_judgement %}<p>{{ d.core_judgement }}</p>{% endif %}
      {% else %}
        <p><b class="sans">核心判断：</b>{{ d.core_judgement }}</p>
        {% if d.evidence %}
        <h3 style="margin-top:14px">判定依据</h3>
        {% for e in d.evidence %}
          {% if e.quote %}
          <blockquote>「{{ e.quote }}」<div class="evi-src">来源：{{ e.source_type }}{% if e.status != 'confirmed' %} · {{ e.status }}{% endif %} · {{ e.point }}</div></blockquote>
          {% else %}
          <p class="muted">· {{ e.point }}（{{ e.source_type }}{% if e.status != 'confirmed' %} · {{ e.status }}{% endif %}）</p>
          {% endif %}
        {% endfor %}
        {% endif %}
        <p><b class="sans">为什么是 {{ d.score }} 分：</b>{{ d.why }}</p>
        <div class="callout"><div class="t">7 分长什么样（固定高标准）</div>{{ d.high_standard }}</div>
        {% if d.next_step %}<p><b class="sans">下一步：</b>{{ d.next_step }}</p>{% endif %}
        {% if d.deliverable_goal %}<p><b class="sans">近期交付目标：</b>{{ d.deliverable_goal }}</p>{% endif %}
        {% if d.translation_rows %}
        <h3>现有经验 → 目标岗位转译表</h3>
        <table class="fold">
          <thead><tr><th>现有经验</th><th>对目标岗位的价值</th><th>还差什么</th></tr></thead>
          {% for row in d.translation_rows %}
          <tr><td data-label="现有经验">{{ row.current }}</td><td data-label="价值">{{ row.target }}</td><td data-label="还差">{{ row.gap }}</td></tr>
          {% endfor %}
        </table>
        {% endif %}
      {% endif %}
    </div>
  </div>
  {% endfor %}
</section>

<!-- ████ 第五章 亮点与潜力 -->
<section id="c5">
  <div class="secno">CHAPTER 05</div>
  <h2>第五章 · 亮点与潜力（不计分）</h2>
  <p class="muted">分数是「截距」，潜力是「斜率」——斜率比截距重要。以下内容不参与评分，但值得你知道。</p>
  {% if narrative1.highlights %}
  <ul>{% for h in narrative1.highlights %}<li><b class="sans">{{ h.title }}</b>：{{ h.detail }}</li>{% endfor %}</ul>
  {% else %}<p class="muted">本次对话中未提炼出额外亮点条目。</p>{% endif %}
</section>

<!-- ████ 第六章 结构性结论 -->
<section id="c6">
  <div class="secno">CHAPTER 06</div>
  <h2>第六章 · {{ '结构性结论' if totals.overall_judgment_allowed else '已确认的发现' }}</h2>
  {% for c in structure.conclusions %}
  <div class="callout">
    <div class="t">{{ '结论' if totals.overall_judgment_allowed else '发现' }} {{ loop.index }}（置信度：{{ c.confidence }}）</div>
    {{ c.text }}
    {% if c.basis_dimensions %}<div class="muted" style="margin-top:6px">依据维度：
    {%- for bd in c.basis_dimensions %}{% for d in dimensions %}{% if d.key == bd %} {{ d.short }}{% endif %}{% endfor %}{% endfor %}</div>{% endif %}
  </div>
  {% endfor %}
  {% if structure.constraints %}
  <h3>现实约束与对策</h3>
  <table class="fold"><thead><tr><th>约束</th><th>对策</th></tr></thead>
  {% for c in structure.constraints %}
  <tr><td data-label="约束">{{ c.constraint }}</td><td data-label="对策">{{ c.counter }}</td></tr>
  {% endfor %}</table>
  {% endif %}
  {% if meta.identity == 'professional' and structure.interview_failure_attribution %}
  <h3>面试挂点归因（可能原因＋验证办法，不是定论）</h3>
  <table class="fold"><thead><tr><th>可能原因</th><th>怎么验证</th></tr></thead>
  {% for a in structure.interview_failure_attribution %}
  <tr><td data-label="可能原因">{{ a.possible_cause }}</td><td data-label="验证办法">{{ a.verify_method }}</td></tr>
  {% endfor %}</table>
  {% endif %}
  {% if not totals.overall_judgment_allowed %}
  <h3>待补信息清单</h3>
  <ul>{% for d in dimensions %}{% if d.pending %}<li>{{ d.short }}：下次诊断优先覆盖</li>{% endif %}{% endfor %}</ul>
  {% endif %}
</section>

<!-- ████ 第七章 行动计划 -->
<section id="c7">
  <div class="secno">CHAPTER 07</div>
  <h2>第七章 · 行动计划</h2>
  <h3>{{ '两周面试应急包' if meta.identity == 'professional' else '本周 3 个动作' }}（每个都附直接可用的交付物）</h3>
  {% for a in narrative2.week_actions %}
  <div class="actioncard">
    <div class="at">动作 {{ loop.index }} · {{ a.action }}</div>
    <p class="muted" style="margin:6px 0">为什么是它：{{ a.why }}</p>
    {% if a.deliverable_template %}<div class="tpl">{{ a.deliverable_template }}</div>{% endif %}
  </div>
  {% endfor %}
  <h3>90 天补底子</h3>
  {% for p in narrative2.ninety_day_plan %}
  <details {{ 'open' if loop.index == 1 else '' }}>
    <summary>{{ p.phase }} · {{ p.focus }}</summary>
    <div class="dcontent"><ul>{% for act in p.actions %}<li>{{ act }}</li>{% endfor %}</ul></div>
  </details>
  {% endfor %}
</section>

<!-- ████ 第八章 自我执行机制 -->
<section id="c8">
  <div class="secno">CHAPTER 08</div>
  <h2>第八章 · 自我执行机制</h2>
  {% if narrative2.weekly_rhythm %}<h3>每周节奏</h3><p>{{ narrative2.weekly_rhythm }}</p>{% endif %}
  {% if narrative2.kanban_checklist %}
  <h3>求职看板清单</h3>
  <ul>{% for item in narrative2.kanban_checklist %}<li>☐ {{ item }}</li>{% endfor %}</ul>
  {% endif %}
  {% if narrative2.retest_advice %}<h3>复测建议</h3><p>{{ narrative2.retest_advice }}</p>{% endif %}
</section>

<!-- ████ 第九章 结语 -->
<section id="c9">
  <div class="secno">CHAPTER 09</div>
  <h2>第九章 · 结语</h2>
  <div class="callout dark">
    <div class="t">致 {{ meta.display_name }}</div>
    {% for para in narrative2.ending_letter.split('\n') %}{% if para.strip() %}<p>{{ para }}</p>{% endif %}{% endfor %}
    <p style="margin-top:14px;text-align:right">—— {{ meta.brand_name }} · {{ meta.date }}</p>
  </div>
  {% if narrative2.week_actions %}
  <div class="callout peach"><div class="t">别忘了，本周的 {{ narrative2.week_actions | length }} 个动作</div>
    <ul>{% for a in narrative2.week_actions %}<li>{{ a.action }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
</section>

</main>
<footer>
  —— 本报告由{{ meta.brand_name }}出品 · AI 生成 ——<br>
  {{ meta.brand_tagline_en }} · 单次对话观察的参考意见，不构成录用预测或职业资格判断<br>
  报告版本生成于 {{ meta.date }} · 低分不是警报，而是地图
</footer>
</body>
</html>
